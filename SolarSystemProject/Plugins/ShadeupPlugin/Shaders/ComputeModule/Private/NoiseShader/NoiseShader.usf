#include "/Engine/Private/Common.ush"

// Hardcoded noise parameters
#define NUM_OCTAVES 4
#define NOISE_STRENGTH 2.0
#define SCALE 20.0
#define PERSISTENCE 0.5
#define LACUNARITY 2.0
#define BASE_FREQUENCY 0.8

Buffer<float> inputVertices;
RWBuffer<float> outputVertices;

// Working noise function
float hash(float n)
{
    return frac(sin(n) * 43758.5453);
}

float noise3D(float3 x)
{
    float3 p = floor(x);
    float3 f = frac(x);
    
    f = f * f * (3.0 - 2.0 * f);
    
    float n = p.x + p.y * 57.0 + 113.0 * p.z;
    
    return lerp(
        lerp(
            lerp(hash(n + 0.0), hash(n + 1.0), f.x),
            lerp(hash(n + 57.0), hash(n + 58.0), f.x), f.y),
        lerp(
            lerp(hash(n + 113.0), hash(n + 114.0), f.x),
            lerp(hash(n + 170.0), hash(n + 171.0), f.x), f.y), f.z);
}

float fractalNoise(float3 p)
{
    float totalNoise = 0.0;
    float amplitude = 1.0;
    float frequency = BASE_FREQUENCY;
    
    for (int octave = 0; octave < NUM_OCTAVES; ++octave)
    {
        totalNoise += noise3D(p * frequency) * amplitude;
        amplitude *= PERSISTENCE;
        frequency *= LACUNARITY;
    }
    
    return totalNoise * 2.0 - 1.0; // Map to [-1, 1]
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void NoiseShader(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    
    // Read vertex count from first element
    uint vertexCount = (uint) inputVertices[0];
    
    if (index >= vertexCount)
        return;
    
    // Read vertex position (skip first element which is vertex count)
    uint dataIndex = index * 3 + 1;
    float3 vertex = float3(
        inputVertices[dataIndex],
        inputVertices[dataIndex + 1],
        inputVertices[dataIndex + 2]
    );
    
    // Normalize vertex position
    float3 normalizedPos = normalize(vertex);
    
    // Calculate fractal noise
    float totalNoise = fractalNoise(normalizedPos);
    
    // Apply noise displacement with reasonable scale
    float3 displacedVertex = vertex + normalizedPos * totalNoise * 10.0;
    
    // Write output
    uint outputIndex = index * 3;
    outputVertices[outputIndex] = displacedVertex.x;
    outputVertices[outputIndex + 1] = displacedVertex.y;
    outputVertices[outputIndex + 2] = displacedVertex.z;
}