#include "/Engine/Public/Platform.ush"

Buffer<float> inputVertices;
RWBuffer<float> outputVertices;

// Crater parameters - positioned on visible hemisphere
static const uint numCraters = 8;
static const float craterCenters[24] =
{
    0.0, 0.0, -400.0, // North pole (center)
    150.0, 150.0, 350.0, // Front-right, upper
    -150.0, 150.0, 350.0, // Front-left, upper  
    200.0, -100.0, 350.0, // Front-right, lower
    -200.0, -100.0, 350.0, // Front-left, lower
    100.0, 0.0, 380.0, // Front-center, slight right
    -100.0, 0.0, 380.0, // Front-center, slight left
    0.0, 250.0, 320.0 // Front-top
};

static const float craterRadii[8] =
{
    90.0, 70.0, 65.0, 60.0, 75.0, 50.0, 55.0, 80.0
};

static const float craterDepths[8] =
{
    50.0, 35.0, 40.0, 30.0, 45.0, 25.0, 28.0, 42.0
};

// Crater shape parameters
static const float rimSteepness = 8.0;
static const float rimWidth = 0.3;
static const float floorHeight = -0.8;
static const float smoothness = 0.2;

float smoothMax(float a, float b, float k)
{
    float h = max(k - abs(a - b), 0.0) / k;
    return max(a, b) + h * h * h * k * (1.0 / 6.0);
}

float smoothMin(float a, float b, float k)
{
    float h = max(k - abs(a - b), 0.0) / k;
    return min(a, b) - h * h * h * k * (1.0 / 6.0);
}

[numthreads(64, 1, 1)]
void CraterShader(
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint GroupIndex : SV_GroupIndex)
{
    uint vertexIndex = DispatchThreadId.x;
   
    // Read vertex count from first element
    uint numVertices = (uint) (inputVertices[0]);
   
    if (vertexIndex >= numVertices)
    {
        return;
    }
   
    // Read input vertex position (skip first element which is vertex count)
    uint baseIndex = vertexIndex * 3 + 1;
    float3 vertexPos = float3(
        inputVertices[baseIndex + 0],
        inputVertices[baseIndex + 1],
        inputVertices[baseIndex + 2]
    );
   
    float totalCraterHeight = 0.0;
   
    // Process each crater using the advanced crater algorithm
    for (uint i = 0; i < numCraters; i++)
    {
        float3 craterCenter = float3(
            craterCenters[i * 3 + 0],
            craterCenters[i * 3 + 1],
            craterCenters[i * 3 + 2]
        );
       
        float craterRadius = craterRadii[i];
       
        // Calculate normalized distance from crater center
        float distance = length(vertexPos - craterCenter);
        float x = distance / craterRadius;
       
        // Only process if within crater influence range
        if (x <= 2.0)
        {
            // Crater cavity (parabolic depression)
            float cavity = x * x - 1.0;
           
            // Crater rim (elevated edge)
            float rimX = min(x - 1.0 - rimWidth, 0.0);
            float rim = rimSteepness * rimX * rimX;
           
            // Combine cavity and rim using smooth operations
            float craterShape = smoothMax(cavity, floorHeight, smoothness);
            craterShape = smoothMin(craterShape, rim, smoothness);
           
            // Apply falloff for smooth blending at crater edges
            float falloff = 1.0 - smoothstep(1.0 + rimWidth, 2.0, x);
           
            // Scale by crater radius and add to total height
            totalCraterHeight += craterShape * craterRadius * falloff;
        }
    }
   
    // Calculate normal for spherical displacement (radial direction)
    float3 normal = normalize(vertexPos);
   
    // Apply displacement along normal (scale factor for visibility)
    float displacementScale = 0.15; // Adjust this to make craters more/less pronounced
    float3 displacedPos = vertexPos + normal * totalCraterHeight * displacementScale;
   
    // Write output
    uint outputIndex = vertexIndex * 3;
    outputVertices[outputIndex + 0] = displacedPos.x;
    outputVertices[outputIndex + 1] = displacedPos.y;
    outputVertices[outputIndex + 2] = displacedPos.z;
}