#include "/Engine/Public/Platform.ush"
int LatitudeSegments;
int LongitudeSegments;
float Radius;
uint MaxVertices;
uint MaxTriangles;
RWBuffer<float> VerticesBuffer;
RWBuffer<int> TrianglesBuffer;
RWBuffer<float> NormalsBuffer;
RWBuffer<float> UVsBuffer;
RWBuffer<int> CountersBuffer;

// Define PI constant for better precision
static const float PI = 3.14159265359f;

// 2D thread dispatch for better GPU utilization
[numthreads(16, 16, 1)]
void SphereGenerationShader(
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint GroupIndex : SV_GroupIndex)
{
    // Use 2D coordinates directly
    uint LatIndex = DispatchThreadId.y;
    uint LonIndex = DispatchThreadId.x;
    
    // Early exit if outside bounds
    if (LatIndex > LatitudeSegments || LonIndex > LongitudeSegments)
        return;
    
    uint ThreadIndex = LatIndex * (LongitudeSegments + 1) + LonIndex;
    
    //Calculate total vertices and triangles
    uint TotalVertices = (LatitudeSegments + 1) * (LongitudeSegments + 1);
    uint TotalTriangleIndices = LatitudeSegments * LongitudeSegments * 6;
    
    // Debug counter writes (remove for production)
    if (ThreadIndex == 0)
    {
        CountersBuffer[0] = TotalVertices;
        CountersBuffer[1] = TotalTriangleIndices;
    }
    
    if (LatIndex <= LatitudeSegments && LonIndex <= LongitudeSegments)
    {
        //Calculate spherical coordinates with better precision
        float LatAngle = (float) LatIndex / (float) LatitudeSegments * PI;
        float LonAngle = (float) LonIndex / (float) LongitudeSegments * 2.0f * PI;
        
        // Use sincos intrinsic for better performance
        float sinLat, cosLat, sinLon, cosLon;
        sincos(LatAngle, sinLat, cosLat);
        sincos(LonAngle, sinLon, cosLon);
        
        float3 Position;
        Position.x = Radius * sinLat * cosLon;
        Position.y = Radius * sinLat * sinLon;
        Position.z = Radius * cosLat;
        
        // Optimized normal calculation - already normalized for unit sphere
        float3 Normal = Position / Radius;
        
        //Had to flip to fix bug - wrong texture orientation
        float2 UV;
        UV.x = (float) LonIndex / (float) LongitudeSegments;
        UV.y = 1.0 - ((float) LatIndex / (float) LatitudeSegments);
        
        //Write to buffer
        uint VertexBaseIndex = ThreadIndex * 3;
        VerticesBuffer[VertexBaseIndex + 0] = Position.x;
        VerticesBuffer[VertexBaseIndex + 1] = Position.y;
        VerticesBuffer[VertexBaseIndex + 2] = Position.z;
        
        NormalsBuffer[VertexBaseIndex + 0] = Normal.x;
        NormalsBuffer[VertexBaseIndex + 1] = Normal.y;
        NormalsBuffer[VertexBaseIndex + 2] = Normal.z;
        
        uint UVBaseIndex = ThreadIndex * 2;
        UVsBuffer[UVBaseIndex + 0] = UV.x;
        UVsBuffer[UVBaseIndex + 1] = UV.y;
    }
    
    //Triangles
    if (LatIndex < LatitudeSegments && LonIndex < LongitudeSegments)
    {
        uint QuadIndex = LatIndex * LongitudeSegments + LonIndex;
        uint TriangleBaseIndex = QuadIndex * 6;
        
        uint TopLeft = LatIndex * (LongitudeSegments + 1) + LonIndex;
        uint TopRight = TopLeft + 1;
        uint BottomLeft = (LatIndex + 1) * (LongitudeSegments + 1) + LonIndex;
        uint BottomRight = BottomLeft + 1;
        
        //Create the two triangles from quad
        if (TriangleBaseIndex + 5 < MaxTriangles)
        {
            TrianglesBuffer[TriangleBaseIndex + 0] = TopLeft;
            TrianglesBuffer[TriangleBaseIndex + 1] = TopRight;
            TrianglesBuffer[TriangleBaseIndex + 2] = BottomLeft;
            
            TrianglesBuffer[TriangleBaseIndex + 3] = TopRight;
            TrianglesBuffer[TriangleBaseIndex + 4] = BottomRight;
            TrianglesBuffer[TriangleBaseIndex + 5] = BottomLeft;
        }
    }
}